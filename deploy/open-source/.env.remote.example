FSVOICE_IMAGE=fsvoice-open-source:cuda13
FSVOICE_HTTP_PORT=5067
FSVOICE_ASSET_CACHE_DIR=E:/path/to/fsvoice-asset-cache
FSVOICE_WORK_DIR=E:/path/to/fsvoice-work

# azureBlob | s3. Use a protected deployment environment for credentials.
FSVOICE_ASSET_MODE=azureBlob
FSVOICE_ASSET_RELEASE_ID=fsvoice-2026-07-14
FSVOICE_ASSET_MANIFEST_KEY=releases/fsvoice-2026-07-14/manifest.json
FSVOICE_ASSET_MANIFEST_SHA256=
FSVOICE_ASSET_RETAIN_RELEASES=2
FSVOICE_ASSET_PARALLEL_DOWNLOADS=4
FSVOICE_ASSET_MAX_RETRIES=5

FSVOICE_AZURE_ACCOUNT_URL=https://example.blob.core.windows.net
FSVOICE_AZURE_CONTAINER=data
FSVOICE_AZURE_SAS_TOKEN=

FSVOICE_S3_BUCKET=
FSVOICE_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

FSVOICE_PARAKEET_PRECISION=fp32
FSVOICE_POCKET_TTS_PRECISION=int8
FSVOICE_MAX_HISTORY_TURNS=10
FSVOICE_ALLOW_BARGE_IN=true
# These budgets include hidden thinking and spoken answer tokens.
OpenSourceVoice__Gemma__ReasoningMaxNewTokens=1024
OpenSourceVoice__Gemma__BalancedReasoningMaxNewTokens=768
OpenSourceVoice__Gemma__FastReasoningMaxNewTokens=192
LLAMA_CPP_VERSION=b9987
LLAMA_CUDA_ARCHITECTURES=80-real;80-virtual
LLAMA_CPP_CONTEXT_SIZE=16384
LLAMA_CPP_GPU_LAYERS=999
LLAMA_CPP_PARALLEL=1
LLAMA_CPP_THREADS=
LLAMA_CPP_EXTRA_ARGS=
LLAMA_CPP_STARTUP_TIMEOUT_SECONDS=900
