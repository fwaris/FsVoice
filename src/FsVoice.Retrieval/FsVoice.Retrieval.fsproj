<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FsVoice.Retrieval</RootNamespace>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <PackageId>FsVoice.Retrieval</PackageId>
    <Description>Source loading, indexing, ranking, keyword enrichment, and PDF document-structure parsing for FsVoice.</Description>
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>FSharp;Voice;Retrieval;PDF;Docling;ONNX;AI</PackageTags>
    <OnnxRuntimeFlavor Condition="'$(OnnxRuntimeFlavor)' == ''">Cpu</OnnxRuntimeFlavor>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="DoclingHybrid.fs" />
    <Compile Include="QueryPostProcessing.fs" />
    <Compile Include="KnowledgeSources.fs" />
    <Compile Include="ContextProviders.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Models\pp-doclayout-m.onnx" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="PackageNotices\PP-DocLayout-M-NOTICE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FsVoice.Core\FsVoice.Core.fsproj" />
    <ProjectReference Include="..\FsVoice.Ctx.Contracts\FsVoice.Ctx.Contracts.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FSharp.Control.AsyncSeq" />
    <PackageReference Include="FSharp.SystemTextJson" />
    <PackageReference Include="FsColbert" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="RapidOcrNet" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup Condition="'$(OnnxRuntimeFlavor)' == 'Cpu'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <ItemGroup Condition="'$(OnnxRuntimeFlavor)' == 'Cuda'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" />
  </ItemGroup>

  <Target Name="ValidateOnnxRuntimeFlavor" BeforeTargets="CollectPackageReferences">
    <Error
      Condition="'$(OnnxRuntimeFlavor)' != 'Cpu' and '$(OnnxRuntimeFlavor)' != 'Cuda'"
      Text="OnnxRuntimeFlavor must be Cpu or Cuda (received '$(OnnxRuntimeFlavor)')." />
  </Target>

</Project>
