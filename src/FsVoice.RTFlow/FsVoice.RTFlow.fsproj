<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FsVoice.RTFlow</RootNamespace>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <PackageId>FsVoice.RTFlow</PackageId>
    <Description>RTFlow adapters for typed FsVoice orchestration sessions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="VoiceFlowSession.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FsVoice.Platform\FsVoice.Platform.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="RTFlow" />
  </ItemGroup>

</Project>
