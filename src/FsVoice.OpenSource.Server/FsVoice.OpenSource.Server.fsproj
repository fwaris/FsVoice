<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FsVoice.OpenSource.Server</RootNamespace>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <OutputType>Exe</OutputType>
    <OnnxRuntimeFlavor Condition="'$(OnnxRuntimeFlavor)' == ''">Cpu</OnnxRuntimeFlavor>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="OpenSourceVoiceVad.fs" />
    <Compile Include="OpenSourceVoiceWebRtc.fs" />
    <Compile Include="OpenSourceVoiceWebSocket.fs" />
    <Compile Include="OpenSourceVoiceWebApp.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="served_runs\**\*" />
    <None Remove="served_runs\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FsVoice.Assets\FsVoice.Assets.fsproj" />
    <ProjectReference Include="..\FsVoice.OpenSource.Runtime\FsVoice.OpenSource.Runtime.fsproj" />
    <ProjectReference Include="..\FsVoice.Retrieval\FsVoice.Retrieval.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FsColbert.Models.MxbaiEdgeColbertV0_32M.Onnx.Int8" />
    <PackageReference Include="SIPSorcery" />
  </ItemGroup>

  <ItemGroup Condition="'$(OnnxRuntimeFlavor)' == 'Cuda'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" />
  </ItemGroup>

  <Target Name="ValidateOnnxRuntimeFlavor" BeforeTargets="CollectPackageReferences">
    <Error
      Condition="'$(OnnxRuntimeFlavor)' != 'Cpu' and '$(OnnxRuntimeFlavor)' != 'Cuda'"
      Text="OnnxRuntimeFlavor must be Cpu or Cuda (received '$(OnnxRuntimeFlavor)')." />
  </Target>

</Project>
