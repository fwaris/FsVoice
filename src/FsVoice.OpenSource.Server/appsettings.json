      "PreRollMs": 300,
      "SpeechPadMs": 100,
      "NumThreads": 1
    },
    "Tts": {
      "ModelDir": "models/pocket-tts-onnx-english-2026-04",
      "ExecutionProvider": "cpu",
      "Precision": "int8",
      "VoiceSamplePath": "voices/default_voice.wav",
      "NumThreads": 2,
      "NumSteps": 4,
      "Temperature": 0.7,
      "Seed": 12345,
      "VoiceEmbeddingCacheCapacity": 4,
      "DecoderChunkFrames": 3,
      "FirstChunkFrames": 2
    },
    "Index": {
      "BundleDirectory": "indexes"
    },
    "Assets": {
      "StatusFile": ""
    }
  }
