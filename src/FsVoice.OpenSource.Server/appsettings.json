{
  "OpenSourceVoice": {
    "WorkDir": "served_runs",
    "MaxHistoryTurns": 10,
    "MaxTurnAudioSeconds": 30,
    "Gemma": {
      "LlamaCppEndpoint": "http://127.0.0.1:8081",
      "LlamaCppModel": "gemma-4-E2B_q4_0-it.gguf",
      "LlamaCppRequestTimeoutSeconds": 180,
      "LlamaCppHealthTimeoutSeconds": 3,
      "ReasoningMaxNewTokens": 1024,
      "AdaptiveReasoning": true,
      "FastReasoningMaxNewTokens": 192,
      "BalancedReasoningMaxNewTokens": 768,
      "ToolMaxRounds": 3,
      "FastToolMaxRounds": 1,
      "BalancedToolMaxRounds": 2,
      "EnableDeterministicToolRouting": true,
      "EnableRagFirst": false,
      "RagFirstMaxResults": 8,
      "EnableThinking": true,
      "LogThoughtText": false
    },
    "Stt": {
      "Runtime": "parakeet-tdt-onnx",
