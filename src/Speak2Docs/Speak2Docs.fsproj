<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PublishAot>false</PublishAot>
    <EnableTrim>false</EnableTrim>
    <NoWarn>$(NoWarn);57</NoWarn>
    <TargetFrameworks>net10.0-ios;net10.0-maccatalyst;net10.0-android</TargetFrameworks>
    <!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
    <!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->
    <OutputType>Exe</OutputType>
    <AssemblyName>Speak2Docs</AssemblyName>
    <Product>Speak2Docs</Product>
    <RootNamespace>Speak2Docs</RootNamespace>
    <UseMaui>true</UseMaui>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <SingleProject>true</SingleProject>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>

    <!-- Display name -->
    <ApplicationTitle>Speak2Docs</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.fsvoice.speak2docs</ApplicationId>
    <ApplicationIdGuid>8BB52405-D58A-46FA-B299-CC07CF58E5F6</ApplicationIdGuid>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <TargetPlatformIdentifier Condition=" $(TargetPlatformIdentifier) == '' ">$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</TargetPlatformIdentifier>

    <SupportedOSPlatformVersion Condition="$(TargetPlatformIdentifier) == 'ios'">15.1</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetPlatformIdentifier) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetPlatformIdentifier) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetPlatformIdentifier) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$(TargetPlatformIdentifier) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$(TargetPlatformIdentifier) == 'tizen'">6.5</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetPlatformIdentifier) == 'ios' and '$(Configuration)' != 'Release'">
    <MtouchLink>None</MtouchLink>
    <UseInterpreter>true</UseInterpreter>
    <MtouchInterpreter>all</MtouchInterpreter>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetPlatformIdentifier) == 'ios' and '$(Configuration)' == 'Release'">
    <UseInterpreter>false</UseInterpreter>
    <MtouchInterpreter></MtouchInterpreter>
    <RunAOTCompilation>true</RunAOTCompilation>
    <EnableAssemblyILStripping>false</EnableAssemblyILStripping>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetPlatformIdentifier) == 'android' and '$(Configuration)' == 'Debug'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetPlatformIdentifier) == 'maccatalyst'">
    <_AppBundleName>$(AssemblyName)</_AppBundleName>
    <MtouchLink>None</MtouchLink>
    <UseInterpreter>true</UseInterpreter>
    <MtouchInterpreter>-all</MtouchInterpreter>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetPlatformIdentifier) == 'ios'">
    <CodesignKey>Apple Development: Faisal Waris (VHX555Y865)</CodesignKey>
    <CodesignProvision>Automatic</CodesignProvision>
    <CodesignTeamId>M4R84H3397</CodesignTeamId>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetPlatformIdentifier) == 'maccatalyst'">
    <CodesignKey>-</CodesignKey>
    <CodesignExtraArgs>--deep</CodesignExtraArgs>
    <CodesignEntitlements>Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Constants.fs" />
    <Compile Include="Icons.fs" />
    <Compile Include="Log.fs" />
    <Compile Include="Settings.fs" />
    <Compile Include="Audio.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="PdfLibrary.fs" />
    <Compile Include="Interaction\Connect.fs" />
    <Compile Include="Interaction\Update.fs" />
    <Compile Include="Views\Theme.fs" />
    <Compile Include="Views\ViewControls.fs" />
    <Compile Include="Views\ToolbarView.fs" />
    <Compile Include="Views\PdfSourcesView.fs" />
    <Compile Include="Views\TermsView.fs" />
    <Compile Include="Views\SettingsView.fs" />
    <Compile Include="Views\IndexPreviewView.fs" />
    <Compile Include="Views\InfoView.fs" />
    <Compile Include="Views\MainView.fs" />
    <Compile Include="App.fs" />
    <Compile Include="MauiProgram.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\*" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiAsset Include="Resources\Raw\FsColbertIndexes\**\*" LogicalName="FsColbertIndexes\%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetPlatformIdentifier) == 'android'">
    <AndroidResource Include="$(AndroidProjectFolder)Resources/*/*" />
    <AndroidResource Remove="$(AndroidProjectFolder)Resources/raw/.*" />
    <AndroidResource Update="$(AndroidProjectFolder)Resources/raw/*" />
    <AndroidAsset Include="$(AndroidProjectFolder)Assets/**/*" Exclude="$(AndroidProjectFolder)Assets/**/.*/**" />
    <AndroidManifest Include="$(AndroidProjectFolder)AndroidManifest.xml" />
    <Compile Include="$(AndroidProjectFolder)MainActivity.fs" />
    <Compile Include="$(AndroidProjectFolder)MainApplication.fs" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetPlatformIdentifier) == 'ios'">
    <None Include="$(iOSProjectFolder)Info.plist" LogicalName="Info.plist" />
    <BundleResource Include="$(iOSProjectFolder)PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
    <Compile Include="$(iOSProjectFolder)AppDelegate.fs" />
    <Compile Include="$(iOSProjectFolder)Program.fs" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetPlatformIdentifier) == 'maccatalyst'">
    <None Include="$(MacCatalystProjectFolder)Info.plist" LogicalName="Info.plist" />
    <BundleResource Include="$(MacCatalystProjectFolder)PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
    <Compile Include="$(MacCatalystProjectFolder)AppDelegate.fs" />
    <Compile Include="$(MacCatalystProjectFolder)Program.fs" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetPlatformIdentifier) == 'windows'">
    <Manifest Include="$(WindowsProjectFolder)app.manifest" />
    <AppxManifest Include="$(WindowsProjectFolder)Package.appxmanifest" />
    <Compile Include="$(WindowsProjectFolder)App.fs" />
    <Compile Include="$(WindowsProjectFolder)Main.fs" />

    <PackageReference Include="FSharp.Maui.WinUICompat" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetPlatformIdentifier) == 'tizen'">
    <TizenManifestFile Include="$(TizenProjectFolder)tizen-manifest.xml" />
    <Compile Include="$(TizenProjectFolder)Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FsVoice.Core\FsVoice.Core.fsproj" />
    <ProjectReference Include="..\FsVoice.Platform\FsVoice.Platform.fsproj" />
    <ProjectReference Include="..\FsVoice.Ctx.Runtime\FsVoice.Ctx.Runtime.fsproj" />
    <ProjectReference Include="..\FsVoice.Retrieval\FsVoice.Retrieval.fsproj" />
    <ProjectReference Include="..\FsVoice.Retrieval.PdfRasterization\FsVoice.Retrieval.PdfRasterization.fsproj" />
    <ProjectReference Include="..\Speak2Docs.Orchestration\Speak2Docs.Orchestration.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fabulous.MauiControls" />
    <PackageReference Include="FsAICore" />
    <PackageReference Include="FSharp.Control.AsyncSeq" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FSharp.DI" />
    <PackageReference Include="FSharp.SystemTextJson" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="RapidOCR.Net" />
    <PackageReference Include="RTOpenAI.Api" />
    <PackageReference Include="RTOpenAI.Events" />
    <PackageReference Include="FsColbert" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetPlatformIdentifier) == 'ios' or $(TargetPlatformIdentifier) == 'maccatalyst'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Maui" Version="10.0.70" />
    <PackageReference Update="Microsoft.Maui.Core" Version="10.0.70" />
    <PackageReference Update="Microsoft.Maui.Controls" Version="10.0.70" />
    <PackageReference Update="Microsoft.Maui.Controls.Compatibility" Version="10.0.70" />
  </ItemGroup>

  <Target Name="PruneStaleAppleAppBundles" BeforeTargets="_CreateAppBundle" Condition="('$(TargetPlatformIdentifier)' == 'ios' or '$(TargetPlatformIdentifier)' == 'maccatalyst') and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <AppleOutputDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OutDir)'))</AppleOutputDirectory>
    </PropertyGroup>

    <Exec Command="/usr/bin/find &quot;$(AppleOutputDirectory)&quot; -maxdepth 1 -type d -name '*.app' ! -name &quot;$(AssemblyName).app&quot; -prune -exec /bin/rm -rf {} +" Condition="Exists('$(AppleOutputDirectory)')" />
  </Target>

  <Target Name="ForceCodesign" AfterTargets="_CodesignAppBundle" Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst' and '$(Configuration)' == 'Debug'">
    <Exec Command="codesign -f -s - --deep &quot;$(MSBuildProjectDirectory)/$(_AppBundlePath)&quot;" />
  </Target>

  <Target Name="EnsurePdfRasterizationReferenceBuilt" BeforeTargets="CoreCompile" Condition="('$(TargetPlatformIdentifier)' == 'ios' or '$(TargetPlatformIdentifier)' == 'android' or '$(TargetPlatformIdentifier)' == 'maccatalyst') and '$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\FsVoice.Retrieval.PdfRasterization\FsVoice.Retrieval.PdfRasterization.fsproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;SelfContained" BuildInParallel="false" />
  </Target>

  <Target Name="RemoveAndroid16IncompatibleNativeLibraries" AfterTargets="_GetLibraryImports" Condition="$(TargetPlatformIdentifier) == 'android'">
    <ItemGroup>
      <!-- Do not remove libjingle_peerconnection_so.so; WebRTC requires it at runtime for realtime voice. -->
      <AndroidNativeLibrary Remove="@(AndroidNativeLibrary)" Condition="'%(Filename)%(Extension)' == 'libonnxruntime_extensions4j_jni.so'" />
      <AndroidNativeLibrary Remove="@(AndroidNativeLibrary)" Condition="'%(Filename)%(Extension)' == 'libortextensions.so'" />
    </ItemGroup>
  </Target>

</Project>
