<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FsVoice.Ctx.Tools</RootNamespace>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <PackageId>FsVoice.Ctx.Tools</PackageId>
    <Description>Optional tool-provider helpers for FsVoice context workflows.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>FSharp;Voice;Context;Tools;AI</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CurrentTimeProvider.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FsVoice.Ctx.Contracts\FsVoice.Ctx.Contracts.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

</Project>
