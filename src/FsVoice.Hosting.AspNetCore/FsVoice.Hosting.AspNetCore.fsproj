<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FsVoice.Hosting.AspNetCore</RootNamespace>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <PackageId>FsVoice.Hosting.AspNetCore</PackageId>
    <Description>ASP.NET bridge runtime for FsVoice browser, WebRTC, and WebSocket hosts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BridgeTypes.fs" />
    <Compile Include="RealtimePipes.fs" />
    <Compile Include="SipTypes.fs" />
    <Compile Include="OpenAiRealtimeRestClient.fs" />
    <Compile Include="OpenAiRtcConfiguration.fs" />
    <Compile Include="OpenAiWebRtcConnectionGate.fs" />
    <Compile Include="OpenAiRealtimeWebRtcSession.fs" />
    <Compile Include="BridgeSession.fs" />
    <Compile Include="BridgeSessionStore.fs" />
    <Compile Include="BridgeEndpoints.fs" />
    <Compile Include="SipCallBridge.fs" />
    <Compile Include="SipHostedService.fs" />
    <Compile Include="SipBridge.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FsVoice.Platform\FsVoice.Platform.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="SIPSorcery" />
  </ItemGroup>

</Project>
