<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FsVoice.Testing</RootNamespace>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <PackageId>FsVoice.Testing</PackageId>
    <Description>Text-only runtime and fake transport helpers for deterministic FsVoice tests.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TextRuntime.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FsVoice.Abstractions\FsVoice.Abstractions.fsproj" />
    <ProjectReference Include="..\FsVoice.Core\FsVoice.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

</Project>
