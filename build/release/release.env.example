# Copy this file to release.env for local release builds.
# Do not commit release.env.

APP_TITLE=Speak2Docs
APP_ID=com.fsvoice.speak2docs
APP_VERSION=1.0.0
APP_BUILD=1

# iOS / App Store
APPLE_TEAM_ID=TEAMID1234
IOS_CODESIGN_KEY=Apple Distribution: Example Inc. (TEAMID1234)
IOS_CODESIGN_PROVISION=Speak2Docs App Store
IOS_RUNTIME_IDENTIFIER=ios-arm64

# Mac Catalyst
MACCATALYST_RUNTIME_IDENTIFIER=maccatalyst-arm64
MACCATALYST_CODESIGN_KEY=-
MACCATALYST_CODESIGN_PROVISION=

# Android / Play Store
ANDROID_APP_ID=com.fsvoice.speak2docs
ANDROID_KEYSTORE=./build/release/speak2docs-upload.keystore
ANDROID_KEY_ALIAS=speak2docs-upload
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
