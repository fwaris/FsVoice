
flowchart TD
    A["PDF source"] --> B["Hybrid parser starts"]
    B --> C["Rasterize PDF pages at 96 DPI"]
    C --> D["Read native PDF text cells with PdfPig"]
    D --> E{"Enough native text per page?"}

    E -- "Yes" --> F["Use native text cells"]
    E -- "No" --> G{"RapidOCR configured?"}
    G -- "Yes" --> H["OCR page and merge with native cells"]
    G -- "No" --> Z["Fail hybrid path"]

    H --> I["Page inputs"]
    F --> I

    I --> J["Load PP-DocLayout-M ONNX"]
    J --> K["Resize page image to 640x640"]
    K --> L["Predict layout regions"]
    L --> M["Attach text cells to layout regions"]
    M --> N["Build Docling document"]
    N --> O["Convert Docling document to passages"]

    O --> P{"Layout produced > 1 passage?"}
    P -- "Yes" --> Q["Use layout passages"]
    P -- "No" --> R["Fallback to Docling native-text conversion"]
    R --> S{"Native-text produced more passages?"}
    S -- "Yes" --> T["Use native-text passages"]
    S -- "No" --> Q

    Q --> U{"Hybrid succeeded?"}
    T --> U
    Z --> V["Fallback to legacy PdfPig parser"]
    U -- "Yes" --> W["Index passages"]
    U -- "No" --> V
    V --> W

